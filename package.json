{
  "name": "@cnaallotey/auto-form-filler",
  "version": "1.3.0",
  "type": "module",
  "description": "A lightweight library to automatically fill and submit forms based on URL query parameters",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c && node -e \"require('fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:package": "node scripts/check-package.cjs",
    "site:build": "npm run build && node -e \"require('fs').copyFileSync('dist/index.umd.js','site/auto-form-filler.js')\"",
    "og": "node scripts/og/render.mjs",
    "prepublishOnly": "npm run build && npm test && npm run test:package"
  },
  "keywords": [
    "form",
    "autofill",
    "query-params",
    "automation",
    "signup"
  ],
  "author": "Charles Nii Adotey Allotey",
  "license": "MIT",
  "homepage": "https://cnaallotey.github.io/auto-form-filler/",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^3.0.0",
    "ts-jest": "^29.0.0",
    "tslib": "^2.6.2",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnaallotey/auto-form-filler.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  },
  "sideEffects": false
}
